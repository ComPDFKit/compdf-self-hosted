# ---- Release identity and immutable images ----
# Product and database schema versions are independent from the infrastructure
# image version. Published releases should replace tag-only application images
# with tag@sha256:digest references generated by the release pipeline.
COMPDF_VERSION=1.1.0
COMPDF_DB_SCHEMA_VERSION=1.1.0
COMPDF_INFRA_IMAGE=compdfkit/compdf-infra:1.0.0
COMPDF_APP_IMAGE=compdfkit/compdf-app:1.0.0
COMPDF_SERVER_IMAGE=compdfkit/compdf-server:1.1.0
COMPDF_SERVER_BUILD_IMAGE=compdfkit/compdf-server:1.1.0-local
COMPDF_SERVER_DEV_IMAGE=compdfkit/compdf-server-dev:1.1.0-local

# ---- API key (client auth for tool APIs) ----
# Leave unset to generate a random key during first initialization. The key is
# persisted to STORAGE_DIR/.api-key-plaintext for ComPDF Web auto-injection. If
# an active key exists but this plaintext is missing or no longer matches, init-db
# rotates that same key row and persists a new random key instead of adding a
# second one. Set this to provision a specific key on every boot; if another
# active key exists, init-db updates that single key row. The value is the secret
# clients send as x-api-key.
# It protects /api/v1/process/* and /api/v1/task/*.
API_KEY=

# ---- CORS ----
# Comma-separated allowed origins. '*' (default) = permissive (reflect any
# origin). Set to specific origins to lock down, e.g.
# CORS_ORIGINS=https://compdf.example.com,https://admin.example.com
CORS_ORIGINS=*

# ---- MCP Server ----
MCP_ENABLED=true
# Set the externally reachable endpoint when using a reverse proxy.
MCP_PUBLIC_URL=http://localhost:8080/mcp
# Additional Host header hostnames (no scheme/port) and exact browser origins.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_MAX_INLINE_FILE_BYTES=4194304

# ---- Tools config flag ----
# / and /pdf-tools/* redirect to /admin. This is the only tools switch.

# ---- Upstream SDK services ----
# The published compdf-app image exposes conversion APIs on :7000 and PDF SDK
# /v1/sync/* APIs on :7001.
PDF_SDK_BASE_URL=http://compdf-app:7001
CONVERSION_BASE_URL=http://compdf-app:7000

# Place the issued SDK license at configs/app-license/license.xml before startup.

# ---- Full stack: docker compose -f docker-compose.full.yml up -d --build --wait --wait-timeout 600 ----
COMPDF_UPDATER_IMAGE=compdfkit/compdf-updater:1.1.0
# Version embedded into both updater binaries; must satisfy the signed release's
# minimumUpdaterVersion. This labels a local build, not an official release.
COMPDF_UPDATER_VERSION=1.1.0
# GitHub update feed. Published by the release workflow after Docker Hub images are ready.
COMPDF_UPDATE_BASE_URL=https://raw.githubusercontent.com/ComPDFKit/compdf-self-hosted/updates/
# The template trusts the current stable update feed. Do not supply a signing private key here.
COMPDF_UPDATE_KEY_ID=compdf-release-20261028
COMPDF_UPDATE_PUBLIC_KEY=3Fq+oPtWLkfwSKRADJZtZxzvzT2j8UUn9eqTcbutt0A=
# Optional: Bearer token for a private update source. Only sent to BASE_URL origin.
# The signed feed is separate from the human-readable GitHub Releases page.
COMPDF_UPDATE_BEARER_TOKEN=
COMPDF_UPDATE_CHANNEL=stable
# 0 disables automatic checks. Otherwise 15..10080 minutes. Installation is manual.
COMPDF_UPDATE_CHECK_INTERVAL_MINUTES=0
COMPDF_UPDATE_AUTO_DOWNLOAD=false
# Must match the existing compdf-infra database password; this does not change it.
COMPDF_UPDATE_MYSQL_PASSWORD=compdfkit-pass-2026
# Optional private image registry login. Leave all three empty for public images.
# REGISTRY is a hostname (e.g. ghcr.io); empty uses Docker Hub.
COMPDF_UPDATE_REGISTRY=
COMPDF_UPDATE_REGISTRY_USERNAME=
COMPDF_UPDATE_REGISTRY_PASSWORD=
