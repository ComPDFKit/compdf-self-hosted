# Literal KEY=value. No quotes, export, shell expansion or inline comments.
# Copy to .env outside the repository; chmod 600 .env.
PROJECT=compdf-apple
# Current Compose baseline is amd64. Uses Rosetta; SDK compatibility is unverified.
# Set arm64 only when ALL THREE images are confirmed to publish linux/arm64.
ARCH=amd64
INFRA_IMAGE=compdfkit/compdf-infra:1.0.0
APP_IMAGE=compdfkit/compdf-app:1.0.0
SERVER_IMAGE=compdfkit/compdf-server:1.1.0
CONFIG_DIR=/Users/yourname/compdf-apple/configs
FONT_DIR=/Users/yourname/compdf-apple/fonts/windows
STORAGE_DIR=/Users/yourname/compdf-apple/storage
# Place the issued SDK license at CONFIG_DIR/app-license/license.xml.
HOST_PORT=8080
INFRA_MEMORY=3G
APP_MEMORY=16G
SERVER_MEMORY=2G
CPUS=2
# 5 seconds between failed checks; execution time of each probe is additional.
HEALTH_ATTEMPTS=60
COMPDF_VERSION=1.1.0
COMPDF_DB_SCHEMA_VERSION=1.1.0
