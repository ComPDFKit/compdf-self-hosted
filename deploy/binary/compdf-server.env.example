NODE_ENV=production
PORT=8080
COMPDF_VERSION=1.1.0
COMPDF_DB_SCHEMA_VERSION=1.1.0

DATABASE_HOST=mysql.example.internal
DATABASE_PORT=3306
DATABASE_USER=compdfkit
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=compdfkit

REDIS_HOST=redis.example.internal
REDIS_PORT=6379
PDF_SDK_BASE_URL=http://compdf-app.example.internal:7001
CONVERSION_BASE_URL=http://compdf-app.example.internal:7000

PUBLIC_DIR=/opt/compdf/current/server/public
LICENSE_TOKEN_PATH=/etc/compdf/license.jwt
INIT_SQL_PATH=/opt/compdf/current/server/release/init.sql
MIGRATIONS_PATH=/opt/compdf/current/server/release/migrations
SETTINGS_PATH=/etc/compdf/settings.yml
STORAGE_DIR=/var/lib/compdf/server-storage
CORS_ORIGINS=https://compdf.example.com
MCP_ENABLED=true
MCP_PUBLIC_URL=https://compdf.example.com/mcp
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_MAX_INLINE_FILE_BYTES=4194304
